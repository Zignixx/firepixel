# Batch Studio: end card "File Name" (BATCH-3, docs\BATCH_MODERN.md §4) – builder, regex,
# plain-language explanation (crates\fp-batch\src\explain.rs), live table (crates\fp-ui\src\batch\rename_ui.rs).
# Prefixes: batch-rx- (explaining the search pattern), batch-rn- (card, replace field, table).

## Errors in the search pattern
batch-rx-err-at = Error at position { $pos }: { $what }
batch-rx-err-compile = Invalid expression: { $error }
batch-rx-err-group-unclosed = Parenthesis "(" is never closed
batch-rx-err-group-unopened = Parenthesis ")" without a matching "("
batch-rx-err-class-unclosed = Square bracket "[" is never closed
batch-rx-err-class-range = Invalid range in square brackets (e.g. "z-a" instead of "a-z")
batch-rx-err-repetition-missing = Repetition ("*", "+", "?") with nothing before it – put "\" in front to search for the character itself
batch-rx-err-repetition-count = Invalid count in curly braces (example: "\d" followed by "2,4" in curly braces)
batch-rx-err-escape-eof = "\" at the end – a character is missing after it
batch-rx-err-escape = Unknown sequence with "\"
batch-rx-err-group-name-duplicate = Group name is used twice
batch-rx-err-group-name = Invalid group name (form: "(?<name>…)")
batch-rx-err-backreference = Back-references like "\1" are not available in the search field – use "$1" in the replace field
batch-rx-err-lookaround = Look-ahead and look-behind ("(?=", "(?!", "(?<=") are not supported
batch-rx-err-flag = Invalid setting in "(?…)"
batch-rx-err-unicode-class = Unknown Unicode class
batch-rx-err-too-complex = The expression is nested too deeply
batch-rx-err-generic = Invalid expression

