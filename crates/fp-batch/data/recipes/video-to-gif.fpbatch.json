{
  "format": "firepixel-batch-recipe",
  "version": 1,
  "name": "Video to small GIF",
  "description": "Read the video at 12 fps, longest side 480 px, GIF with the optimizer preset balanced.",
  "steps": [
    { "id": "video.import", "enabled": true, "params": { "fps": 12 } },
    { "id": "resize", "enabled": true, "params": { "mode": "longEdge", "size": 480, "onlyShrink": true, "filter": "auto" } }
  ],
  "output": { "format": "gif", "options": { "preset": "balanced", "quality": 80 } }
}
